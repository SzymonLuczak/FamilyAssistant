# No credentials are required in Milestone 1.
CORE_PORT=8080
TZ=Europe/Warsaw
WHATSAPP_SEND_ENABLED=false
WHATSAPP_AUTO_CONNECT=false
SUMMARY_SCHEDULER_ENABLED=true
SUMMARY_SEND_ENABLED=false
WHATSAPP_GROUP_ID=
BIEDRONKA_ACCOUNT_1_LABEL=Konto 1
BIEDRONKA_ACCOUNT_2_LABEL=Konto 2

BIEDRONKA_DOWNLOADS_DIR=./imports/browser-downloads
# Propozycje zakupów na WhatsApp (grupa wybrana przez select-shopping-group)
SHOPPING_WHATSAPP_ENABLED=false
# Dni propozycji po angielsku, po przecinku, np. Monday,Thursday; puste = tylko przycisk w /shopping
SHOPPING_PROPOSAL_DAY=
SHOPPING_PROPOSAL_TIME=18:00
# Gazetki Biedronki: klucz z console.anthropic.com (puste = wyłączone)
ANTHROPIC_API_KEY=
LEAFLET_MODEL=claude-sonnet-5
LEAFLET_MAX_PAGES=120
